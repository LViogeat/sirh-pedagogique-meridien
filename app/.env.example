# Copiez ce fichier en « .env » (dans ce dossier app/) et remplissez les deux
# lignes avec ce que l'intervenant vous a remis. Puis relancez « npm run dev ».

VITE_API_TOKEN=le-jeton-de-votre-groupe
VITE_MODULE_CODE=le-code-de-votre-groupe

# L'URL de l'API du cours est déjà connue de l'application : cette ligne ne
# sert qu'à la remplacer, par exemple pour travailler sur une API locale.
# VITE_API_URL=http://localhost:8000
