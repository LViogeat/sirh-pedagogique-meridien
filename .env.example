# ── API (service « api » dans Coolify) ───────────────────────────────────────

# Fournie par le service PostgreSQL de Coolify. Noter le pilote « +psycopg ».
DATABASE_URL=postgresql+psycopg://sirh:motdepasse@db:5432/sirh

# Le jour 1 du cours. TOUT le jeu de données est calculé par rapport à cette
# date : ancienneté, contrats arrivant à échéance, campagne d'entretiens en
# cours. À régler avant la première séance, et à ne plus toucher ensuite.
DATE_REFERENCE=2026-09-15

# Les six groupes : code:libellé:jeton[:type_besoin], séparés par des virgules.
#
# Le code est aussi le nom du schéma PostgreSQL du groupe.
# Le quatrième champ dit quel type de besoin identifié ce module a le droit de
# prendre en charge. Trois modules seulement en consomment ; les trois autres
# n'ont pas ce champ, et l'API leur refusera toute écriture sur les besoins.
GROUPES=rec:Recrutement:CHANGEZ-MOI-rec:recrutement,form:Formation:CHANGEZ-MOI-form:formation,mob:Mobilité & carrière:CHANGEZ-MOI-mob:mobilite,gta:Gestion des temps:CHANGEZ-MOI-gta,portail:Portail RH & Self-Service:CHANGEZ-MOI-portail,onb:Onboarding & Offboarding:CHANGEZ-MOI-onb

# Ouvre /admin : remise à zéro, régénération des besoins. À garder pour vous.
JETON_ADMIN=CHANGEZ-MOI-admin

# Les fronts des groupes tournent sur d'autres sous-domaines que l'API.
# « * » convient au cours ; sinon, lister les origines séparées par des virgules.
ORIGINES_AUTORISEES=*

# Garde-fous sur le SQL des étudiants : une requête trop longue est interrompue,
# une réponse trop volumineuse est tronquée.
DELAI_MAX_SQL_MS=5000
LIGNES_MAX_SQL=2000


# ── Front (service « app » dans Coolify, un par groupe) ──────────────────────

# L'URL publique de l'API, sans barre oblique finale.
VITE_API_URL=https://sirh-api.exemple.fr

# Le jeton du groupe qui utilise cette instance.
VITE_API_TOKEN=CHANGEZ-MOI-rec

# Le code du module du groupe. Sert à préremplir la console SQL.
VITE_MODULE_CODE=rec
